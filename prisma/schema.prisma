datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model SavedSearch {
  id        String   @id @default(uuid())
  query     String
  condition String   @default("used")
  createdAt DateTime @default(now())
}

model RacketWatchlist {
  id          String   @id @default(uuid())
  racketName  String
  targetPrice Float
  condition   String   @default("used")
  createdAt   DateTime @default(now())
}